# Database
POSTGRES_PRISMA_URL="postgres://user:password@host:5432/database?pgbouncer=true"

# Hugging Face Serverless Inference API (primary text provider)
HF_TOKEN="hf_your_token"

# Optional text fallbacks used only when Hugging Face is unavailable/quota-limited
GROQ_API_KEY="gsk_your_key"
GROQ_MODEL="openai/gpt-oss-120b"
OPENROUTER_API_KEY="sk-or-v1_your_key"
OPENROUTER_MODEL="openai/gpt-oss-20b:free"
PROFILE_AUDIT_MODEL="mistralai/Mistral-7B-Instruct-v0.3"

# Optional visual fallback (used for photographic requests or HF failures)
IMAGE_FALLBACK_PROVIDER="auto"
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Telegram
TELEGRAM_BOT_TOKEN="123456:your-bot-token"
TELEGRAM_CHAT_ID="123456789"
TELEGRAM_WEBHOOK_SECRET="generate-a-long-random-secret"

# LinkedIn
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_PERSON_URN="urn:li:person:your-id"
LINKEDIN_VERSION="202606"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your-token"

# Application and cron
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
CRON_SECRET="generate-a-long-random-secret"
DASHBOARD_ADMIN_TOKEN="generate-a-long-random-token"
# Career Engine (optional: configure an authorized JSON jobs feed; never scrape LinkedIn)
CAREER_PROFILE_JSON='{"name":"Seu Nome","headline":"Engenheiro de Dados | Python | Cloud","about":"Resumo profissional com cases e resultados.","skills":["Python","SQL","Airflow","AWS","PostgreSQL"],"targetTitles":["Engenheiro de Dados"]}'
LINKEDIN_JOBS_FEED_URL=""
# Optional local override for npm run generate:draft
DRAFT_APP_URL="http://localhost:3000"
# Optional ISO timestamp used to reproduce a specific scheduling week
DRAFT_TRIGGERED_AT=""
# Inbound e-mail webhook for job links
INBOUND_EMAIL_TOKEN="generate-a-long-random-token"
JINA_API_KEY=""
