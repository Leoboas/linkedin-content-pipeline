generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum FunnelStage {
  ATTENTION
  INTEREST
  DESIRE
  ACTION
}

enum EditorialPillar {
  TOFU
  MOFU
  BOFU
}

enum FormatType {
  CAROUSEL_PDF
  SINGLE_IMAGE
  TEXT_ONLY
}

enum PostStatus {
  DRAFT
  PENDING
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  REJECTED_PENDING_FEEDBACK
  REGENERATING
  PUBLISHING
  CANCELLED
  ARCHIVED
}

enum JobListingStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum JobSource {
  LINKEDIN
  AUTHORIZED_FEED
  MANUAL
}

enum SearchRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

enum JobEligibilityStatus {
  ELIGIBLE
  RESTRICTED
  UNKNOWN
  BRAZIL_ELIGIBLE
  LATAM_ELIGIBLE
  WORLDWIDE_ELIGIBLE
  RELOCATION_REQUIRED
  REGION_RESTRICTED
}

enum AuthorizedResumeProfile {
  DATA_ENGINEERING
  PYTHON_BACKEND
}

enum AuthorizedResumeLanguage {
  PT_BR
  EN
}

enum ResumeDraftStatus {
  DRAFT
  AWAITING_REVIEW
  APPROVED
  ARCHIVED
}

enum JobApplicationStatus {
  SAVED
  READY_FOR_REVIEW
  RESUME_PREPARED
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_TEST
  OFFER
  REJECTED
  WITHDRAWN
  ARCHIVED
}

enum ApplicationPreparationStatus {
  NOT_QUEUED
  QUEUED
  PREPARING
  NEEDS_INFORMATION
  READY_FOR_REVIEW
  APPROVED_FOR_SUBMISSION
  SUBMITTING
  SUBMISSION_FAILED
  MANUAL_ACTION_REQUIRED
}

enum ApplicationKitReviewStatus {
  NEEDS_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum JobApplicationEventType {
  PREPARATION_STATUS_CHANGED
  RECRUITMENT_STATUS_CHANGED
  KIT_CREATED
  KIT_APPROVED
  NOTE_ADDED
  RECRUITER_CONTACT_RECORDED
  INTERVIEW_RECORDED
}

enum KnowledgeSourceType {
  RESUME
  REPOSITORY
  DOCUMENT
  USER_CONFIRMATION
  EDITORIAL_PLAN
  CONVERSATION
}

enum KnowledgeTrustLevel {
  VERIFIED
  HIGH
  MEDIUM
  NEEDS_REVIEW
}

enum KnowledgeVisibility {
  PUBLIC_SAFE
  INTERNAL_ONLY
  RESTRICTED
}

enum ProfessionalFactCategory {
  SKILL
  CAREER
  EDUCATION
  LEADERSHIP
  ARCHITECTURE
  METRIC
  LANGUAGE
  POSITIONING
}

enum KnowledgeEvidenceStatus {
  VERIFIED
  DOCUMENTED
  USER_CONFIRMED
  NEEDS_REVIEW
  RESTRICTED
}

enum ImplementationStatus {
  IMPLEMENTED
  USED_IN_PORTFOLIO
  GENERAL_KNOWLEDGE
  PLANNED
  UNKNOWN
}

enum PortfolioProjectKind {
  PORTFOLIO
  SYNTHETIC_DEMO
  ACADEMIC
  OPEN_SOURCE
  PLANNED
}

enum KnowledgeImportStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum QualityGateStatus {
  PASS
  NEEDS_REVISION
  BLOCKED
}

enum NetworkingReferenceStatus {
  SAVED
  REVIEWED
  COMMENT_PREPARED
  INTERACTED
  ARCHIVED
}

enum NetworkingActivityType {
  DISCUSSION_REVIEWED
  COMMENT_PREPARED
  COMMENT_PUBLISHED
  REPLY_RECEIVED
  RELEVANT_CONNECTION
  PROFESSIONAL_CONVERSATION
}

enum NetworkingTargetType {
  PROFESSIONAL
  COMPANY
}

enum NetworkingCommentApproach {
  TECHNICAL_INSIGHT
  TRADE_OFF
  PRACTICAL_EXAMPLE
  TECHNICAL_QUESTION
  CONSTRUCTIVE_COUNTERPOINT
}

enum NetworkingAiAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum EditorialExperimentStatus {
  PLANNED
  RUNNING
  INSUFFICIENT_DATA
  READY_FOR_REVIEW
  COMPLETED
  CANCELLED
}

enum EditorialRecommendationStatus {
  SUGGESTED
  APPROVED
  REJECTED
  DEFERRED
  APPLIED
}

enum CareerOutcomeOrigin {
  POST_CONFIRMED
  NETWORKING_CONFIRMED
  LINKEDIN_SEARCH
  DIRECT_APPLICATION
  REFERRAL
  OTHER
  UNKNOWN
}

enum CareerOutcomeType {
  RECRUITER_CONTACT
  HIRING_MANAGER_CONVERSATION
  PROFESSIONAL_CONNECTION
  INTERVIEW_INVITATION
  QUALIFIED_OPPORTUNITY
  OTHER
}

enum CareerOutcomeStage {
  CONTACTED
  CONVERSATION
  INTERVIEW
  OPPORTUNITY
  OFFER
  CLOSED
  UNKNOWN
}

enum CareerOutcomeAssociation {
  CONFIRMED
  HYPOTHESIS
  UNLINKED
}

enum PostProjectRole {
  PRIMARY
  SECONDARY
}

enum MediaAssetOrigin {
  GENERATED_AI
  CHATGPT_UPLOAD
  DASHBOARD_UPLOAD
  TELEGRAM_UPLOAD
  STOCK
  IMPORTED
}

enum MediaStorageProvider {
  VERCEL_BLOB
  EXTERNAL
}

enum CreativeBriefMediaRole {
  PRIMARY_IMAGE
  CAROUSEL_SLIDE
  FINAL_PDF
  SOURCE_REFERENCE
}

enum ApprovalAuditEventType {
  APPROVED
  INVALIDATED
  REJECTED
}

model EditorialLine {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  themes               Json
  toneOfVoice          String    @db.Text
  aidaRules            String    @db.Text
  cvCases              String    @db.Text
  language             String    @default("pt-BR")
  postsPerWeek         Int       @default(4)
  languageDistribution Json      @default("{\"pt-BR\":2,\"en-US\":2}")
  weeklySchedule       Json      @default("[{\"weekday\":1,\"localTime\":\"13:00\",\"language\":\"en-US\",\"objective\":\"Discovery\"},{\"weekday\":2,\"localTime\":\"16:00\",\"language\":\"pt-BR\",\"objective\":\"Authority\"},{\"weekday\":4,\"localTime\":\"13:00\",\"language\":\"en-US\",\"objective\":\"Proof\"},{\"weekday\":5,\"localTime\":\"16:00\",\"language\":\"pt-BR\",\"objective\":\"Career Conversion\"}]")
  lastStockRefillAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  posts                Post[]
}

model KnowledgeSource {
  id                String                   @id @default(uuid()) @db.Uuid
  sourceKey         String                   @unique
  type              KnowledgeSourceType
  title             String
  uri               String?
  contentHash       String
  trustLevel        KnowledgeTrustLevel
  visibility        KnowledgeVisibility      @default(INTERNAL_ONLY)
  asOf              DateTime?
  importedAt        DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  documents         KnowledgeDocument[]
  factSources       ProfessionalFactSource[]
  experienceSources ExperienceSource[]
  projectSources    ProjectSource[]
  creativeEvidence  CreativeBriefEvidence[]

  @@index([type, trustLevel])
  @@index([contentHash])
}

model KnowledgeDocument {
  id               String                  @id @default(uuid()) @db.Uuid
  sourceId         String                  @db.Uuid
  filename         String
  mimeType         String
  content          String                  @db.Text
  contentHash      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  source           KnowledgeSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  creativeEvidence CreativeBriefEvidence[]

  @@unique([sourceId, contentHash])
  @@index([sourceId])
}

model ProfessionalFact {
  id                   String                   @id @default(uuid()) @db.Uuid
  factKey              String                   @unique
  claim                String                   @db.Text
  category             ProfessionalFactCategory
  evidenceStatus       KnowledgeEvidenceStatus
  implementationStatus ImplementationStatus
  visibility           KnowledgeVisibility      @default(INTERNAL_ONLY)
  publicAllowed        Boolean                  @default(false)
  confidentialityNote  String?                  @db.Text
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  sources              ProfessionalFactSource[]
  creativeEvidence     CreativeBriefEvidence[]

  @@index([category, evidenceStatus])
  @@index([publicAllowed, visibility])
}

model ProfessionalFactSource {
  factId               String           @db.Uuid
  sourceId             String           @db.Uuid
  excerpt              String?          @db.Text
  excerptPublicAllowed Boolean          @default(false)
  verifiedAt           DateTime?
  fact                 ProfessionalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  source               KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([factId, sourceId])
}

model ProfessionalExperience {
  id                  String                  @id @default(uuid()) @db.Uuid
  experienceKey       String                  @unique
  company             String
  title               String
  startDate           DateTime?
  endDate             DateTime?
  current             Boolean                 @default(false)
  summary             String                  @db.Text
  technologies        Json
  editorialAngles     Json?
  evidenceStatus      KnowledgeEvidenceStatus
  visibility          KnowledgeVisibility     @default(INTERNAL_ONLY)
  publicAllowed       Boolean                 @default(false)
  confidentialityNote String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sources             ExperienceSource[]
  creativeEvidence    CreativeBriefEvidence[]

  @@index([company, current])
  @@index([publicAllowed, evidenceStatus])
}

model ExperienceSource {
  experienceId String                 @db.Uuid
  sourceId     String                 @db.Uuid
  experience   ProfessionalExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  source       KnowledgeSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([experienceId, sourceId])
}

model PortfolioProject {
  id                   String                  @id @default(uuid()) @db.Uuid
  projectKey           String                  @unique
  name                 String
  kind                 PortfolioProjectKind
  publicUrl            String?
  summary              String                  @db.Text
  technologies         Json
  themes               Json?
  limitations          Json?
  implementationStatus ImplementationStatus
  evidenceStatus       KnowledgeEvidenceStatus
  visibility           KnowledgeVisibility     @default(PUBLIC_SAFE)
  publicAllowed        Boolean                 @default(true)
  confidentialityNote  String?                 @db.Text
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  sources              ProjectSource[]
  postLinks            PostProject[]
  creativeEvidence     CreativeBriefEvidence[]

  @@index([kind, implementationStatus])
  @@index([publicAllowed, evidenceStatus])
}

model ProjectSource {
  projectId String           @db.Uuid
  sourceId  String           @db.Uuid
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source    KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([projectId, sourceId])
}

model KnowledgeImportRun {
  id             String                @id @default(uuid()) @db.Uuid
  importKey      String
  contentHash    String
  status         KnowledgeImportStatus
  filesProcessed Int                   @default(0)
  recordsCreated Int                   @default(0)
  recordsUpdated Int                   @default(0)
  recordsSkipped Int                   @default(0)
  errorMessage   String?               @db.Text
  startedAt      DateTime              @default(now())
  completedAt    DateTime?

  @@unique([importKey, contentHash])
  @@index([status, startedAt])
}

model Post {
  id                      String                       @id @default(uuid()) @db.Uuid
  generationKey           String?                      @unique
  editorialLineId         String?                      @db.Uuid
  editorialPillar         EditorialPillar              @default(TOFU)
  funnelStage             FunnelStage
  formatType              FormatType
  language                String                       @default("pt-BR")
  editorialObjective      String?                      @db.Text
  associatedProject       String?
  topic                   String?
  mediaError              String?                      @db.Text
  title                   String
  textContent             String                       @db.Text
  imagePrompt             String?                      @db.Text
  slidesJson              Json?
  mediaUrl                String?
  status                  PostStatus                   @default(PENDING)
  scheduledFor            DateTime
  scheduledDate           DateTime?
  publishedAt             DateTime?
  linkedinPostId          String?
  engagementScore         Float?
  engagementLabel         String?
  qualityScore            Float?
  qualityStatus           QualityGateStatus?
  qualityReview           Json?
  qualityReviewedAt       DateTime?
  feedbackText            String?                      @db.Text
  rejectionFeedback       String?                      @db.Text
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  editorialLine           EditorialLine?               @relation(fields: [editorialLineId], references: [id], onDelete: SetNull)
  metrics                 PostMetric[]
  analyticsAttempts       AnalyticsCollectionAttempt[]
  versions                PostVersion[]                @relation("PostVersions")
  creativeBriefs          CreativeBrief[]              @relation("PostCreativeBriefs")
  projectLinks            PostProject[]
  currentVersionId        String?                      @db.Uuid
  currentVersion          PostVersion?                 @relation("PostCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  approvedCreativeBriefId String?                      @db.Uuid
  approvedCreativeBrief   CreativeBrief?               @relation("CurrentPostApproval", fields: [approvedCreativeBriefId], references: [id], onDelete: SetNull)
  approvalEvents          PostApprovalEvent[]
  experimentLinks         EditorialExperimentPost[]
  careerOutcomes          CareerOutcome[]

  @@index([status, scheduledFor])
  @@index([editorialLineId])
  @@index([editorialLineId, editorialPillar, status, engagementScore])
  @@index([qualityStatus, qualityScore])
}

model PostVersion {
  id              String              @id @default(uuid()) @db.Uuid
  postId          String              @db.Uuid
  title           String
  textContent     String              @db.Text
  slidesJson      Json?
  imagePrompt     String?             @db.Text
  mediaUrl        String?
  reason          String?             @db.Text
  versionNumber   Int?
  contentHash     String?
  createdAt       DateTime            @default(now())
  post            Post                @relation("PostVersions", fields: [postId], references: [id], onDelete: Cascade)
  currentForPosts Post[]              @relation("PostCurrentVersion")
  creativeBriefs  CreativeBrief[]
  approvalEvents  PostApprovalEvent[]

  @@unique([postId, versionNumber])
  @@index([postId, createdAt])
}

model CreativeBrief {
  id                String                  @id @default(uuid()) @db.Uuid
  postId            String                  @db.Uuid
  version           Int
  thesis            String                  @db.Text
  technicalConflict String                  @db.Text
  concreteProblem   String                  @db.Text
  visualConcept     String                  @db.Text
  shortOverlayTitle String?
  evidenceSnapshot  Json?
  effectivePrompt   String?                 @db.Text
  mediaUrl          String?
  aestheticScore    Int?
  semanticScore     Int?
  technicalScore    Int?
  reviewStatus      QualityGateStatus?
  reviewSnapshot    Json?
  postVersionId     String?                 @db.Uuid
  creativeRevision  Int?
  language          String?
  contentHash       String?
  mediaHash         String?
  contentBrief      Json?
  visualBrief       Json?
  createdAt         DateTime                @default(now())
  post              Post                    @relation("PostCreativeBriefs", fields: [postId], references: [id], onDelete: Cascade)
  postVersion       PostVersion?            @relation(fields: [postVersionId], references: [id], onDelete: Cascade)
  media             CreativeBriefMedia[]
  evidence          CreativeBriefEvidence[]
  approvedByPosts   Post[]                  @relation("CurrentPostApproval")
  approvalEvents    PostApprovalEvent[]

  @@unique([postId, version])
  @@unique([postVersionId, creativeRevision])
  @@index([postId, createdAt])
  @@index([postVersionId, createdAt])
}

model PostProject {
  id          String           @id @default(uuid()) @db.Uuid
  postId      String           @db.Uuid
  projectId   String           @db.Uuid
  role        PostProjectRole
  confirmedAt DateTime         @default(now())
  confirmedBy String?
  auditNote   String?          @db.Text
  createdAt   DateTime         @default(now())
  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  project     PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([postId, projectId])
  @@index([projectId, role])
}

model CreativeBriefEvidence {
  id                       String                  @id @default(uuid()) @db.Uuid
  creativeBriefId          String                  @db.Uuid
  evidenceKey              String
  factId                   String?                 @db.Uuid
  experienceId             String?                 @db.Uuid
  projectId                String?                 @db.Uuid
  sourceId                 String                  @db.Uuid
  knowledgeDocumentId      String?                 @db.Uuid
  claimSnapshot            String                  @db.Text
  authorizedExcerpt        String?                 @db.Text
  sourceHash               String
  trustLevelSnapshot       KnowledgeTrustLevel
  visibilitySnapshot       KnowledgeVisibility
  sourceVisibilitySnapshot KnowledgeVisibility
  implementationStatus     ImplementationStatus
  publicAllowedSnapshot    Boolean
  createdAt                DateTime                @default(now())
  creativeBrief            CreativeBrief           @relation(fields: [creativeBriefId], references: [id], onDelete: Cascade)
  fact                     ProfessionalFact?       @relation(fields: [factId], references: [id], onDelete: Restrict)
  experience               ProfessionalExperience? @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  project                  PortfolioProject?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  source                   KnowledgeSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  document                 KnowledgeDocument?      @relation(fields: [knowledgeDocumentId], references: [id], onDelete: Restrict)

  @@unique([creativeBriefId, evidenceKey])
  @@index([factId])
  @@index([experienceId])
  @@index([projectId])
  @@index([sourceId])
}

model MediaAsset {
  id              String               @id @default(uuid()) @db.Uuid
  origin          MediaAssetOrigin
  storageProvider MediaStorageProvider
  storageKey      String?              @unique
  storageUrl      String               @db.Text
  sha256          String
  contentType     String
  byteSize        BigInt?
  width           Int?
  height          Int?
  metadata        Json?
  createdAt       DateTime             @default(now())
  createdBy       String?
  briefLinks      CreativeBriefMedia[]

  @@index([sha256])
  @@index([origin, createdAt])
}

model CreativeBriefMedia {
  id              String                 @id @default(uuid()) @db.Uuid
  creativeBriefId String                 @db.Uuid
  mediaAssetId    String                 @db.Uuid
  role            CreativeBriefMediaRole
  position        Int                    @default(0)
  createdAt       DateTime               @default(now())
  creativeBrief   CreativeBrief          @relation(fields: [creativeBriefId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset             @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([creativeBriefId, role, position])
  @@index([mediaAssetId])
}

model PostApprovalEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  postId          String                 @db.Uuid
  postVersionId   String                 @db.Uuid
  creativeBriefId String                 @db.Uuid
  eventType       ApprovalAuditEventType
  actor           String?
  reason          String?                @db.Text
  createdAt       DateTime               @default(now())
  post            Post                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postVersion     PostVersion            @relation(fields: [postVersionId], references: [id], onDelete: Cascade)
  creativeBrief   CreativeBrief          @relation(fields: [creativeBriefId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([postVersionId, creativeBriefId])
}

model PostMetric {
  id                      String                @id @default(uuid()) @db.Uuid
  postId                  String                @db.Uuid
  linkedinPostId          String?
  impressions             Int?
  membersReached          Int?
  reactions               Int?
  comments                Int?
  shares                  Int?
  postSaves               Int?
  postSends               Int?
  linkClicks              Int?
  premiumCtaClicks        Int?
  followersGained         Int?
  profileViews            Int?
  profileViewsFromContent Int?
  impressionsInNetwork    Int?
  impressionsOutOfNetwork Int?
  inNetworkPercent        Float?
  outOfNetworkPercent     Float?
  audienceBreakdown       Json?
  engagementScore         Float?
  interactionRate         Float?
  source                  String                @default("LEGACY")
  apiVersion              String?
  measurementWindow       String                @default("LIFETIME")
  availability            String                @default("UNKNOWN")
  publishedAtSnapshot     DateTime?
  exposureHours           Float?
  latenessHours           Float?
  sourceNote              String?               @db.Text
  importBatchId           String?               @db.Uuid
  importRowNumber         Int?
  idempotencyKey          String?               @unique
  capturedAt              DateTime              @default(now())
  post                    Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  importBatch             AnalyticsImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([postId, capturedAt])
  @@index([postId, measurementWindow, source])
  @@index([engagementScore])
  @@index([importBatchId])
}

model EditorialLearningCycle {
  id                   String   @id @default(uuid()) @db.Uuid
  cycleKey             String   @unique @default("primary")
  startDate            DateTime @db.Date
  timezone             String   @default("America/Sao_Paulo")
  plannedPostsPerWeek  Int      @default(4)
  languageDistribution Json     @default("{\"en-US\":2,\"pt-BR\":2}")
  scheduleSnapshot     Json     @default("[{\"weekday\":1,\"localTime\":\"13:00\",\"language\":\"en-US\"},{\"weekday\":2,\"localTime\":\"16:00\",\"language\":\"pt-BR\"},{\"weekday\":4,\"localTime\":\"13:00\",\"language\":\"en-US\"},{\"weekday\":5,\"localTime\":\"16:00\",\"language\":\"pt-BR\"}]")
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
}

model EditorialExperiment {
  id                    String                          @id @default(uuid()) @db.Uuid
  name                  String
  hypothesis            String                          @db.Text
  professionalObjective String                          @db.Text
  primaryMetric         String
  secondaryMetrics      Json                            @default("[]")
  variableTested        String
  periodStart           DateTime
  periodEnd             DateTime
  comparisonCriteria    Json                            @default("{}")
  minimumObservations   Int                             @default(4)
  status                EditorialExperimentStatus       @default(PLANNED)
  results               Json?
  limitations           Json?
  recommendation        String?                         @db.Text
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @default(now()) @updatedAt
  posts                 EditorialExperimentPost[]
  evaluations           EditorialExperimentEvaluation[]

  @@index([status, periodStart, periodEnd])
  @@index([variableTested, primaryMetric])
}

model EditorialExperimentEvaluation {
  id                String              @id @default(uuid()) @db.Uuid
  experimentId      String              @db.Uuid
  measurementWindow String
  metric            String
  dataFingerprint   String
  results           Json
  observedAt        DateTime            @default(now())
  experiment        EditorialExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, dataFingerprint])
  @@index([experimentId, observedAt])
}

model EditorialExperimentPost {
  experimentId String              @db.Uuid
  postId       String              @db.Uuid
  armLabel     String
  notes        String?             @db.Text
  addedAt      DateTime            @default(now())
  experiment   EditorialExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  post         Post                @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([experimentId, postId])
  @@index([postId])
}

model EditorialRecommendation {
  id                String                        @id @default(uuid()) @db.Uuid
  recommendationKey String                        @unique
  title             String
  diagnosis         String                        @db.Text
  dataSnapshot      Json
  periodStart       DateTime
  periodEnd         DateTime
  sampleSize        Int                           @default(0)
  hypothesis        String                        @db.Text
  justification     String                        @db.Text
  confidence        String                        @default("LOW")
  nextAction        String                        @db.Text
  limitations       Json
  status            EditorialRecommendationStatus @default(SUGGESTED)
  decisionNote      String?                       @db.Text
  decidedAt         DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([periodStart, periodEnd])
}

model QualifiedAudienceCriteria {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @default("primary")
  roles     Json     @default("[\"Data Engineer\",\"Backend Engineer\",\"Senior Software Engineer\",\"Staff Engineer\",\"Principal Engineer\",\"Tech Lead\",\"Software Architect\",\"Engineering Manager\",\"Hiring Manager\",\"Technical Recruiter\"]")
  markets   Json     @default("[\"BR\",\"US\",\"EU\"]")
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
}

model CareerOutcome {
  id                   String                   @id @default(uuid()) @db.Uuid
  company              String?
  contactName          String?
  contactRole          String?
  roleTitle            String?
  market               String?
  occurredAt           DateTime
  type                 CareerOutcomeType
  origin               CareerOutcomeOrigin      @default(UNKNOWN)
  association          CareerOutcomeAssociation @default(UNLINKED)
  postId               String?                  @db.Uuid
  networkingActivityId String?                  @db.Uuid
  jobApplicationId     String?                  @db.Uuid
  processStage         CareerOutcomeStage       @default(UNKNOWN)
  observation          String?                  @db.Text
  result               String?                  @db.Text
  evidenceNote         String?                  @db.Text
  idempotencyKey       String?                  @unique
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @default(now()) @updatedAt
  post                 Post?                    @relation(fields: [postId], references: [id], onDelete: SetNull)
  networkingActivity   NetworkingActivity?      @relation(fields: [networkingActivityId], references: [id], onDelete: SetNull)
  jobApplication       JobApplication?          @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)

  @@index([occurredAt, type])
  @@index([origin, association])
  @@index([company, occurredAt])
  @@index([postId])
  @@index([networkingActivityId])
  @@index([jobApplicationId])
}

model AnalyticsImportBatch {
