  @@index([type, companyName])
  @@index([monitoredCompanyId])
}

model CandidateProfile {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  headline          String               @db.Text
  about             String               @db.Text
  location          String?
  linkedinUrl       String?
  skills            Json
  experience        Json?
  education         Json?
  targetTitles      Json
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  documents         CareerDocument[]
  matches           JobMatch[]
  seoAudits         LinkedInSeoAudit[]
  resumeDrafts      ResumeDraft[]
  searchPreferences JobSearchPreference?
  applications      JobApplication[]
  authorizedResumes AuthorizedResume[]
}

model JobSearchPreference {
  id                String           @id @default(uuid()) @db.Uuid
  profileId         String           @unique @db.Uuid
  targetTitles      Json
  locations         Json
  minimumMatchScore Int              @default(65)
