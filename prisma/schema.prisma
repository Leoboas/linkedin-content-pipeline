generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum FunnelStage {
  ATTENTION
  INTEREST
  DESIRE
  ACTION
}

enum EditorialPillar {
  TOFU
  MOFU
  BOFU
}

enum FormatType {
  CAROUSEL_PDF
  SINGLE_IMAGE
  TEXT_ONLY
}

enum PostStatus {
  DRAFT
  PENDING
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  REJECTED_PENDING_FEEDBACK
  REGENERATING
  PUBLISHING
  CANCELLED
  ARCHIVED
}

enum JobListingStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum JobSource {
  LINKEDIN
  AUTHORIZED_FEED
  MANUAL
}

enum SearchRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ResumeDraftStatus {
  DRAFT
  AWAITING_REVIEW
  APPROVED
  ARCHIVED
}

enum QualityGateStatus {
  PASS
  NEEDS_REVISION
  BLOCKED
}

model EditorialLine {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  themes      Json
  toneOfVoice String   @db.Text
  aidaRules   String   @db.Text
  cvCases     String   @db.Text
  language    String   @default("pt-BR")
  lastStockRefillAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id              String         @id @default(uuid()) @db.Uuid
  generationKey   String?        @unique
  editorialLineId String?        @db.Uuid
  editorialPillar EditorialPillar @default(TOFU)
  funnelStage     FunnelStage
  formatType      FormatType
  title           String
  textContent     String         @db.Text
  imagePrompt     String?        @db.Text
  slidesJson      Json?
  mediaUrl        String?
  status          PostStatus     @default(PENDING)
  scheduledFor    DateTime
  scheduledDate   DateTime?
  publishedAt     DateTime?
  linkedinPostId  String?
  engagementScore Float?
  engagementLabel String?
  qualityScore Float?
  qualityStatus QualityGateStatus?
  qualityReview Json?
  qualityReviewedAt DateTime?
  feedbackText    String?        @db.Text
  rejectionFeedback String?      @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  editorialLine   EditorialLine? @relation(fields: [editorialLineId], references: [id], onDelete: SetNull)
  metrics         PostMetric[]

  @@index([status, scheduledFor])
  @@index([editorialLineId])
  @@index([editorialLineId, editorialPillar, status, engagementScore])
  @@index([qualityStatus, qualityScore])
}

model PostMetric {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @db.Uuid
  impressions     Int      @default(0)
  reactions       Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  profileViews    Int      @default(0)
  engagementScore Float?
  capturedAt      DateTime @default(now())
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, capturedAt])
  @@index([engagementScore])
}

model ContentReference {
  id          String   @id @default(uuid()) @db.Uuid
  content     String   @db.Text
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model RejectionPattern {
  id           String   @id @default(uuid()) @db.Uuid
  pattern      String   @unique
  occurrenceCount Int   @default(0)
  lastFeedback String?  @db.Text
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([occurrenceCount])
}

model CandidateProfile {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  headline       String   @db.Text
  about          String   @db.Text
  location       String?
  linkedinUrl    String?
  skills         Json
  experience     Json?
  education      Json?
  targetTitles   Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  documents      CareerDocument[]
  matches        JobMatch[]
  seoAudits      LinkedInSeoAudit[]
  resumeDrafts   ResumeDraft[]
}

model CareerDocument {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  title       String
  content     String   @db.Text
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model ResumeDraft {
  id             String           @id @default(uuid()) @db.Uuid
  profileId      String           @db.Uuid
  sourceJobId    String?          @db.Uuid
  targetRole     String
  template       String
  jobDescription String?          @db.Text
  content        Json
  atsScore       Float            @default(0)
  validation     Json?
  status         ResumeDraftStatus @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceJob      JobListing?      @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)

  @@index([profileId, updatedAt])
  @@index([targetRole, atsScore])
}

model JobListing {
  id                 String            @id @default(uuid()) @db.Uuid
  source             JobSource
  externalId         String
  title              String
  company            String?
  location           String?
  remote             Boolean           @default(false)
  url                String
  description        String            @db.Text
  sourcePublishedAt  DateTime?
  discoveredAt       DateTime          @default(now())
  status             JobListingStatus  @default(OPEN)
  rawData            Json?
  matches            JobMatch[]
  resumeDrafts       ResumeDraft[]

  @@unique([source, externalId])
  @@index([status, discoveredAt])
  @@index([title, location])
}

model JobMatch {
  id              String          @id @default(uuid()) @db.Uuid
  profileId       String          @db.Uuid
  jobId           String          @db.Uuid
  score           Float
  label           String
  matchedSkills   Json
  skillGaps       Json
  rationale       String          @db.Text
  ragContext      String?         @db.Text
  createdAt       DateTime        @default(now())
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job             JobListing      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
  @@index([profileId, score])
}

model LinkedInSeoAudit {
  id              String          @id @default(uuid()) @db.Uuid
  profileId       String          @db.Uuid
  score           Float
  strengths       Json
  recommendations Json
  snapshot        Json
  createdAt       DateTime        @default(now())
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model SkillRadar {
  id             String   @id @default(uuid()) @db.Uuid
  skill          String
  category       String
  demandCount    Int      @default(0)
  candidateLevel Float?
  gapScore       Float    @default(0)
  evidence       Json?
  updatedAt      DateTime @updatedAt

  @@unique([skill, category])
  @@index([gapScore])
}

model CareerSearchRun {
  id           String          @id @default(uuid()) @db.Uuid
  status       SearchRunStatus @default(RUNNING)
  queryCount   Int             @default(0)
  resultCount  Int             @default(0)
  errorMessage String?         @db.Text
  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([status, startedAt])
}
