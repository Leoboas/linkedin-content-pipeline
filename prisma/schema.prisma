  activities  NetworkingActivity[]

  @@index([referenceId, createdAt])
  @@index([createdAt])
}

model NetworkingAiAttempt {
  id            String                    @id @default(uuid()) @db.Uuid
  referenceId   String                    @db.Uuid
  status        NetworkingAiAttemptStatus @default(STARTED)
  errorCategory String?
  createdAt     DateTime                  @default(now())
  finishedAt    DateTime?
  reference     NetworkingReference       @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([createdAt, status])
  @@index([referenceId, createdAt])
}

model NetworkingActivity {
  id                    String                  @id @default(uuid()) @db.Uuid
  occurredAt            DateTime                @default(now())
  type                  NetworkingActivityType
  referenceId           String?                 @db.Uuid
  commentDraftId        String?                 @db.Uuid
  topicKey              String?
  language              String?
  companyName           String?
  professionalRole      String?
  preparedComment       String?                 @db.Text
  publishedComment      String?                 @db.Text
  publicationConfirmed  Boolean                 @default(false)
  newRelevantConnection Boolean                 @default(false)
  conversationStarted   Boolean                 @default(false)
  notes                 String?                 @db.Text
  idempotencyKey        String?                 @unique
  createdAt             DateTime                @default(now())
  reference             NetworkingReference?    @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  commentDraft          NetworkingCommentDraft? @relation(fields: [commentDraftId], references: [id], onDelete: SetNull)
  careerOutcomes        CareerOutcome[]

  @@index([occurredAt, type])
  @@index([topicKey, occurredAt])
}

model NetworkingRoutine {
