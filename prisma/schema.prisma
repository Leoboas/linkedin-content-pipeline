  updatedAt         DateTime           @updatedAt
  networkingTargets NetworkingTarget[]

  @@index([active, priority])
}

model CareerDocument {
  id        String           @id @default(uuid()) @db.Uuid
  profileId String           @db.Uuid
  title     String
  content   String           @db.Text
  sourceUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model ResumeDraft {
  id              String            @id @default(uuid()) @db.Uuid
  profileId       String            @db.Uuid
  sourceJobId     String?           @db.Uuid
  targetRole      String
  template        String
  jobDescription  String?           @db.Text
  content         Json
  atsScore        Float             @default(0)
  validation      Json?
  status          ResumeDraftStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  profile         CandidateProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceJob       JobListing?       @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)
  applications    JobApplication[]
  applicationKits ApplicationKit[]

  @@index([profileId, updatedAt])
  @@index([targetRole, atsScore])
}

model JobListing {
  id                String           @id @default(uuid()) @db.Uuid
  source            JobSource
  externalId        String
  title             String
  company           String?
  location          String?
  remote            Boolean          @default(false)
  url               String
  description       String           @db.Text
  sourcePublishedAt DateTime?
  discoveredAt      DateTime         @default(now())
  status            JobListingStatus @default(OPEN)
  rawData           Json?
  matches           JobMatch[]
  resumeDrafts      ResumeDraft[]
  applications      JobApplication[]

  @@unique([source, externalId])
  @@index([status, discoveredAt])
  @@index([title, location])
}

model JobApplication {
  id                   String                       @id @default(uuid()) @db.Uuid
  profileId            String                       @db.Uuid
  jobId                String                       @db.Uuid
  resumeDraftId        String?                      @db.Uuid
  authorizedResumeId   String?                      @db.Uuid
  status               JobApplicationStatus         @default(SAVED)
  preparationStatus    ApplicationPreparationStatus @default(NOT_QUEUED)
  preparationAttempt   Int                          @default(0)
  notes                String?                      @db.Text
  recruiterContact     String?                      @db.Text
  appliedAt            DateTime?
  submissionEvidence   String?                      @db.Text
  submissionEvidenceAt DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  profile              CandidateProfile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job                  JobListing                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeDraft          ResumeDraft?                 @relation(fields: [resumeDraftId], references: [id], onDelete: SetNull)
  authorizedResume     AuthorizedResume?            @relation(fields: [authorizedResumeId], references: [id], onDelete: SetNull)
  careerOutcomes       CareerOutcome[]
  events               JobApplicationEvent[]
  kits                 ApplicationKit[]

  @@unique([profileId, jobId])
  @@index([profileId, status, updatedAt])
  @@index([jobId, status])
}

model JobApplicationEvent {
  id                   String                  @id @default(uuid()) @db.Uuid
  applicationId        String                  @db.Uuid
  eventType            JobApplicationEventType
  fromRecruitmentStage String?
  toRecruitmentStage   String?
  fromPreparationStage String?
  toPreparationStage   String?
  source               String                  @default("USER")
  note                 String?                 @db.Text
  details              Json?
  idempotencyKey       String?                 @unique
  createdAt            DateTime                @default(now())
  application          JobApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([eventType, createdAt])
}

model ApplicationKit {
  id                     String                     @id @default(uuid()) @db.Uuid
  applicationId          String                     @db.Uuid
  requestKey             String                     @unique
  version                Int
  baseResumeId           String?                    @db.Uuid
  resumeDraftId          String?                    @db.Uuid
  language               AuthorizedResumeLanguage
  tailoredResume         Json
  coverLetter            String                     @db.Text
  knownAnswers           Json                       @default("{}")
  unverifiedRequirements Json                       @default("[]")
  requiredConfirmations  Json                       @default("[]")
  submissionChecklist    Json                       @default("[]")
  reviewStatus           ApplicationKitReviewStatus @default(NEEDS_REVIEW)
  documentSha256         String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  application            JobApplication             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  baseResume             AuthorizedResume?          @relation(fields: [baseResumeId], references: [id], onDelete: SetNull)
  resumeDraft            ResumeDraft?               @relation(fields: [resumeDraftId], references: [id], onDelete: SetNull)

  @@unique([applicationId, version])
  @@index([applicationId, createdAt])
  @@index([reviewStatus, createdAt])
}

model JobMatch {
  id                      String               @id @default(uuid()) @db.Uuid
  profileId               String               @db.Uuid
  jobId                   String               @db.Uuid
  score                   Float
  scoreVersion            String               @default("career-match-v2")
  scoreBreakdown          Json                 @default("{}")
  label                   String
  matchedSkills           Json
  skillGaps               Json
  rationale               String               @db.Text
  ragContext              String?              @db.Text
  eligibilityStatus       JobEligibilityStatus @default(UNKNOWN)
  eligibilityReasons      Json                 @default("[]")
  evidenceConfidence      Int                  @default(0)
  recommendedResumeId     String?              @db.Uuid
  recommendedResumeReason String?              @db.Text
  createdAt               DateTime             @default(now())
  profile                 CandidateProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job                     JobListing           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recommendedResume       AuthorizedResume?    @relation(fields: [recommendedResumeId], references: [id], onDelete: SetNull)

  @@unique([profileId, jobId])
  @@index([profileId, score])
  @@index([eligibilityStatus, score])
  @@index([recommendedResumeId])
}

model LinkedInSeoAudit {
  id              String           @id @default(uuid()) @db.Uuid
  profileId       String           @db.Uuid
