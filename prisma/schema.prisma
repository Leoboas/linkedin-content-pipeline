  language        AuthorizedResumeLanguage
  version         String
  sha256          String
  contentType     String
  byteSize        Int
  fileData        Bytes                    @db.ByteA
  authorizedAt    DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  profile         CandidateProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  matches         JobMatch[]
  applications    JobApplication[]
  applicationKits ApplicationKit[]

  @@index([profileId, profileType, language])
}
