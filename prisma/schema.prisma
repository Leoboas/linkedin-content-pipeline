}

model NetworkingReference {
  id                 String                    @id @default(uuid()) @db.Uuid
  canonicalUrl       String                    @unique
  sourceDomain       String
  authorName         String?
  authorRole         String?
  companyName        String?
  title              String?
  summary            String?                   @db.Text
  content            String                    @default("") @db.Text
  language           String                    @default("unknown")
  topicKey           String?
  relevanceScore     Int                       @default(0)
  relevanceRationale Json?
  status             NetworkingReferenceStatus @default(SAVED)
  notes              String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  reviewedAt         DateTime?
  commentDrafts      NetworkingCommentDraft[]
  aiAttempts         NetworkingAiAttempt[]
  activities         NetworkingActivity[]

  @@index([status, createdAt])
  @@index([topicKey, language, status])
  @@index([companyName])
}

model NetworkingCommentDraft {
  id          String                    @id @default(uuid()) @db.Uuid
  referenceId String                    @db.Uuid
  approach    NetworkingCommentApproach
  comment     String                    @db.Text
